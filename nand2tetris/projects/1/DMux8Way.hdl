// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    Not(in=sel[0], out=notsel0);
    DMux4Way(in=in, sel=sel[1..2], a=t1, b=t2, c=t3, d=t4);
    And(a=t1, b=notsel0, out=a);
    And(a=t1, b=sel[0], out=b);
    And(a=t2, b=notsel0, out=c);
    And(a=t2, b=sel[0], out=d);
    And(a=t3, b=notsel0, out=e);
    And(a=t3, b=sel[0], out=f);
    And(a=t4, b=notsel0, out=g);
    And(a=t4, b=sel[0], out=h);
}
